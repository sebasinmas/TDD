{
  "name": "tdd-scaffold",
  "version": "1.0.0",
  "description": "Scaffold para desarrollo guiado por pruebas (TDD) con TypeScript y Vitest",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "tdd",
    "typescript",
    "vitest",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
